# Data provider: "local" (default — on-device AsyncStorage, no setup) or "supabase".
EXPO_PUBLIC_DATA_PROVIDER=local

# Required only when EXPO_PUBLIC_DATA_PROVIDER=supabase.
# 1. Create a project at supabase.com, run supabase/schema.sql in the SQL editor.
# 2. Project Settings → API → copy these two values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
