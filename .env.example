# Data provider: "local" (on-device AsyncStorage, zero setup — used by the
# public share-URL web build) or "supabase" (real cloud backend).
EXPO_PUBLIC_DATA_PROVIDER=local

# Required when EXPO_PUBLIC_DATA_PROVIDER=supabase:
# 1. Create a project at supabase.com (free tier).
# 2. SQL editor → run supabase/schema.sql, then supabase/setup-extras.sql.
# 3. Auth → Providers → confirm Email is enabled. Then Auth → Email Templates:
#    edit BOTH "Confirm signup" and "Magic Link" to show the 6-digit code —
#    the default templates only send a link, which the app's code entry
#    can't use. Body must contain {{ .Token }}.
# 4. Project Settings → API → copy these two values:
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 5. Optional but required for true account deletion (Apple 5.1.1(v)):
#    npx supabase login && npx supabase link --project-ref <ref>
#    npx supabase functions deploy delete-account

# Shows Settings → Testing tools in non-dev builds (used for the share URL).
# Leave unset for TestFlight/App Store builds.
# EXPO_PUBLIC_DEV_TOOLS=1
